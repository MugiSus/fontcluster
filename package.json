{
  "name": "fontcluster",
  "version": "1.2.0",
  "description": "A font clustering and visualization tool powered by Tauri.",
  "author": "mugisus",
  "homepage": "https://fontcluster.mugisus.me",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "release": "cargo release --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check"
  },
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/geist": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/history": "^0.2.5",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/storage": "^4.4.0",
    "@solid-primitives/utils": "^6.4.1",
    "@tanstack/solid-virtual": "^3.13.53",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@use-gesture/vanilla": "10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "d3-array": "^3.2.5",
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "d3-quadtree": "^3.0.2",
    "d3-random": "^3.0.2",
    "d3-scale": "^4.0.3",
    "fuse.js": "^7.5.0",
    "lru-cache": "^11.5.3",
    "lucide-solid": "^1.75.0",
    "motion": "^14.14.0",
    "solid-js": "^1.9.19",
    "solid-sonner": "^0.3.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0",
    "troika-three-text": "^0.53.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/culori": "^4.0.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-random": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-solid": "^0.20.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@10.34.9"
}
